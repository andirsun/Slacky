{
  "name": "slacky",
  "version": "0.0.10",
  "description": "Slack wrapper for Linux arm64 systems",
  "main": "dist/app/src/app.js",
  "scripts": {
    "start": "electron .",
    "build": "swc src -d dist/app",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run start\"",
    "pack": "npm run build && USE_SYSTEM_FPM=1 electron-builder",
    "publish": "USE_SYSTEM_FPM=1 electron-builder --publish always",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andirsun/Slacky.git"
  },
  "author": "Anderson Laverde <hola@andersonlaverde.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andirsun/Slacky/issues",
    "email": "hola@andersonlaverde.com"
  },
  "homepage": "https://github.com/andirsun/Slacky#readme",
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3"
  }
}
